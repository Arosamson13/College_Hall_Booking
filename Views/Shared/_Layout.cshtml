<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - College Hall Booking System</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- FullCalendar CSS -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-surface">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-wrapper">
            <!-- Sidebar Navigation -->
            <aside class="sidebar" id="sidebar">
                <div class="sidebar-header">
                    <div class="brand-logo">
                        <div class="logo-icon bg-gradient-primary">
                            <i class="bi bi-building-fill-check"></i>
                        </div>
                        <div class="brand-text">
                            <span class="brand-title">UniHall</span>
                            <span class="brand-subtitle">Booking System</span>
                        </div>
                    </div>
                </div>

                <div class="sidebar-user">
                    <div class="avatar bg-gradient-accent">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="user-info">
                        <div class="user-name">@User.Identity?.Name</div>
                        <div class="user-role badge bg-primary-subtle text-primary">
                            @(User.IsInRole("Admin") ? "System Admin" : "Department User")
                        </div>
                    </div>
                </div>

                <ul class="nav-menu">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" && ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Halls" ? "active" : "")" asp-controller="Admin" asp-action="Halls">
                                <i class="bi bi-door-open-fill"></i>
                                <span>Halls Management</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Departments" ? "active" : "")" asp-controller="Admin" asp-action="Departments">
                                <i class="bi bi-diagram-3-fill"></i>
                                <span>Departments</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Bookings" ? "active" : "")" asp-controller="Admin" asp-action="Bookings">
                                <i class="bi bi-calendar-check-fill"></i>
                                <span>Booking Requests</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Admin" asp-action="Reports">
                                <i class="bi bi-bar-chart-line-fill"></i>
                                <span>Reports & Analytics</span>
                            </a>
                        </li>
                    }
                    else if (User.IsInRole("Department"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" && ViewContext.RouteData.Values["controller"]?.ToString() == "Department" ? "active" : "")" asp-controller="Department" asp-action="Dashboard">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Halls" ? "active" : "")" asp-controller="Department" asp-action="Halls">
                                <i class="bi bi-building"></i>
                                <span>Browse Halls</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "BookRequest" ? "active" : "")" asp-controller="Department" asp-action="BookRequest">
                                <i class="bi bi-calendar-plus-fill"></i>
                                <span>Request Booking</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyBookings" ? "active" : "")" asp-controller="Department" asp-action="MyBookings">
                                <i class="bi bi-clock-history"></i>
                                <span>My Bookings</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Calendar" ? "active" : "")" asp-controller="Department" asp-action="Calendar">
                                <i class="bi bi-calendar3"></i>
                                <span>Availability Calendar</span>
                            </a>
                        </li>
                    }
                </ul>

                <div class="sidebar-footer">
                    <a class="nav-link text-white-50" asp-controller="Account" asp-action="ChangePassword">
                        <i class="bi bi-key-fill me-2"></i> Change Password
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                        <button type="submit" class="btn btn-outline-light w-100 btn-sm mt-2">
                            <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                        </button>
                    </form>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="main-content">
                <header class="topbar">
                    <button class="btn btn-icon me-3 d-md-none" id="sidebarToggle">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <div class="topbar-title">
                        <h4 class="mb-0 font-weight-700">@ViewData["Title"]</h4>
                    </div>
                    <div class="topbar-actions ms-auto d-flex align-items-center gap-3">
                        <span class="text-muted fs-7 d-none d-sm-inline">
                            <i class="bi bi-calendar-event me-1"></i> @DateTime.Now.ToString("ddd, dd MMM yyyy")
                        </span>
                        <div class="dropdown">
                            <button class="btn btn-light rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li><h6 class="dropdown-header">Logged in as @User.Identity?.Name</h6></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-shield-lock me-2"></i>Change Password</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <div class="content-container">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                            <span>@TempData["SuccessMessage"]</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                            <span>@TempData["ErrorMessage"]</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </div>
            </main>
        </div>
    }
    else
    {
        <div class="auth-wrapper">
            @RenderBody()
        </div>
    }

    <!-- JavaScript Dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
