@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center py-5">
    <div class="display-1 text-danger mb-3"><i class="bi bi-shield-x"></i></div>
    <h1 class="font-weight-800">403 - Access Denied</h1>
    <p class="lead text-muted mb-4">You do not have permission to view or manage this resource.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-3 font-weight-600">
        <i class="bi bi-house-door me-1"></i> Return to Safety
    </a>
</div>
