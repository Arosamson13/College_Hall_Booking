@model CollegeHallBooking.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-warning-subtle text-warning rounded-3 fs-3">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <div>
                        <h4 class="font-weight-700 mb-0">Change Password</h4>
                        @if (Model.IsFirstTimeLogin)
                        {
                            <p class="text-warning mb-0 fs-7">Please update your temporary password before proceeding.</p>
                        }
                        else
                        {
                            <p class="text-muted mb-0 fs-7">Update your login credentials securely</p>
                        }
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label font-weight-600"></label>
                        <input asp-for="CurrentPassword" class="form-control bg-light" placeholder="Enter current / temporary password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger fs-7"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label font-weight-600"></label>
                        <input asp-for="NewPassword" class="form-control bg-light" placeholder="Enter new strong password" />
                        <span asp-validation-for="NewPassword" class="text-danger fs-7"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label font-weight-600"></label>
                        <input asp-for="ConfirmPassword" class="form-control bg-light" placeholder="Confirm new password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger fs-7"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary py-2 font-weight-600 rounded-3">
                            <i class="bi bi-check-circle me-1"></i> Save New Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
