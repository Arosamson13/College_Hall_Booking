@model CollegeHallBooking.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Overview";
}

<!-- Metrics Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card metric-card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body d-flex align-items-center justify-content-between p-4">
                <div>
                    <div class="text-uppercase text-muted fs-7 font-weight-700 tracking-wider">Total Halls</div>
                    <div class="metric-value font-weight-800 fs-2 text-dark mt-1">@Model.TotalHalls</div>
                    <span class="text-success fs-7"><i class="bi bi-check-circle me-1"></i>@Model.ActiveHalls Active</span>
                </div>
                <div class="metric-icon bg-primary-subtle text-primary rounded-4 p-3 fs-3">
                    <i class="bi bi-building"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card metric-card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body d-flex align-items-center justify-content-between p-4">
                <div>
                    <div class="text-uppercase text-muted fs-7 font-weight-700 tracking-wider">Pending Requests</div>
                    <div class="metric-value font-weight-800 fs-2 text-warning mt-1">@Model.PendingRequests</div>
                    <span class="text-muted fs-7">Requires action</span>
                </div>
                <div class="metric-icon bg-warning-subtle text-warning rounded-4 p-3 fs-3">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card metric-card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body d-flex align-items-center justify-content-between p-4">
                <div>
                    <div class="text-uppercase text-muted fs-7 font-weight-700 tracking-wider">Approved Bookings</div>
                    <div class="metric-value font-weight-800 fs-2 text-success mt-1">@Model.ApprovedBookings</div>
                    <span class="text-success fs-7"><i class="bi bi-calendar-event me-1"></i>@Model.UpcomingReservations Upcoming</span>
                </div>
                <div class="metric-icon bg-success-subtle text-success rounded-4 p-3 fs-3">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card metric-card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body d-flex align-items-center justify-content-between p-4">
                <div>
                    <div class="text-uppercase text-muted fs-7 font-weight-700 tracking-wider">Departments</div>
                    <div class="metric-value font-weight-800 fs-2 text-info mt-1">@Model.TotalDepartments</div>
                    <span class="text-muted fs-7">Registered users</span>
                </div>
                <div class="metric-icon bg-info-subtle text-info rounded-4 p-3 fs-3">
                    <i class="bi bi-diagram-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Pending Approval Section -->
<div class="row g-4 mb-4">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="font-weight-700 mb-0">Pending Approval Requests</h5>
                    <p class="text-muted fs-7 mb-0">Review booking applications submitted by departments</p>
                </div>
                <a asp-controller="Admin" asp-action="Bookings" class="btn btn-light btn-sm font-weight-600">View All</a>
            </div>
            <div class="card-body p-4">
                @if (!Model.PendingBookingList.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check-all fs-1 text-success mb-2 d-block"></i>
                        <p class="mb-0">All booking requests have been processed!</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Hall</th>
                                    <th>Department</th>
                                    <th>Date & Time</th>
                                    <th>Purpose</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.PendingBookingList)
                                {
                                    <tr>
                                        <td>
                                            <span class="font-weight-700 text-dark d-block">@b.Hall?.Name</span>
                                            <small class="text-muted"><i class="bi bi-people me-1"></i>Cap: @b.Hall?.Capacity | Exp: @b.ExpectedParticipants</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-dark">@b.Department?.DepartmentCode</span>
                                            <small class="d-block text-muted">@b.Department?.DepartmentName</small>
                                        </td>
                                        <td>
                                            <span class="d-block font-weight-600">@b.BookingDate.ToString("dd MMM yyyy")</span>
                                            <small class="text-muted">@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</small>
                                        </td>
                                        <td>
                                            <span class="text-truncate d-inline-block" style="max-width: 180px;" title="@b.Purpose">@b.Purpose</span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-success btn-sm font-weight-600 me-1" data-bs-toggle="modal" data-bs-target="#approveModal-@b.Id">
                                                <i class="bi bi-check-lg me-1"></i> Approve
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm font-weight-600" data-bs-toggle="modal" data-bs-target="#rejectModal-@b.Id">
                                                <i class="bi bi-x-lg me-1"></i> Reject
                                            </button>

                                            <!-- Approve Modal -->
                                            <div class="modal fade text-start" id="approveModal-@b.Id" tabindex="-1">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content rounded-4 border-0">
                                                        <div class="modal-header border-0">
                                                            <h5 class="modal-title font-weight-700">Approve Booking Request</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <form asp-action="ApproveBooking" method="post">
                                                            <div class="modal-body">
                                                                <input type="hidden" name="id" value="@b.Id" />
                                                                <p>Are you sure you want to approve booking for <strong>@b.Hall?.Name</strong> by <strong>@b.Department?.DepartmentName</strong> on <strong>@b.BookingDate.ToString("dd MMM yyyy")</strong>?</p>
                                                                <div class="mb-3">
                                                                    <label class="form-label font-weight-600">Admin Remarks / Instructions (Optional)</label>
                                                                    <textarea name="remarks" class="form-control" rows="2" placeholder="e.g. Approved. Keys available at main office."></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer border-0">
                                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-success font-weight-600">Confirm Approval</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Reject Modal -->
                                            <div class="modal fade text-start" id="rejectModal-@b.Id" tabindex="-1">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content rounded-4 border-0">
                                                        <div class="modal-header border-0">
                                                            <h5 class="modal-title font-weight-700 text-danger">Reject Booking Request</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <form asp-action="RejectBooking" method="post">
                                                            <div class="modal-body">
                                                                <input type="hidden" name="id" value="@b.Id" />
                                                                <p>Please state the reason for rejecting <strong>@b.Department?.DepartmentName</strong>'s request for <strong>@b.Hall?.Name</strong>:</p>
                                                                <div class="mb-3">
                                                                    <label class="form-label font-weight-600">Rejection Reason</label>
                                                                    <textarea name="remarks" class="form-control" rows="3" required placeholder="e.g. Hall reserved for maintenance or overlapping campus exam."></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer border-0">
                                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-danger font-weight-600">Confirm Rejection</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Quick Action / Upcoming Reservations Sidebar -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <h5 class="font-weight-700 mb-0">Upcoming Confirmed Events</h5>
                <p class="text-muted fs-7 mb-0">Approved reservations</p>
            </div>
            <div class="card-body p-4">
                @if (!Model.UpcomingBookingList.Any())
                {
                    <p class="text-muted fs-7 text-center py-3">No upcoming confirmed reservations.</p>
                }
                else
                {
                    <div class="timeline">
                        @foreach (var res in Model.UpcomingBookingList)
                        {
                            <div class="timeline-item mb-3 pb-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="badge bg-primary-subtle text-primary font-weight-600">@res.Department?.DepartmentCode</span>
                                    <span class="fs-7 text-muted">@res.BookingDate.ToString("MMM dd")</span>
                                </div>
                                <h6 class="font-weight-700 text-dark mb-1">@res.Purpose</h6>
                                <div class="fs-7 text-muted">
                                    <i class="bi bi-door-open me-1"></i>@res.Hall?.Name
                                    <span class="mx-1">•</span>
                                    <i class="bi bi-clock me-1"></i>@res.StartTime.ToString(@"hh\:mm") - @res.EndTime.ToString(@"hh\:mm")
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
