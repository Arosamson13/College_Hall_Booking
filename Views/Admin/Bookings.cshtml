@model CollegeHallBooking.ViewModels.BookingFilterViewModel
@{
    ViewData["Title"] = "Booking Management & Requests";
}

<div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
    <div class="card-body p-4">
        <form method="get" asp-action="Bookings" class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label font-weight-600 fs-7">Select Hall</label>
                <select asp-for="HallId" class="form-select bg-light">
                    <option value="">-- All Halls --</option>
                    @foreach (var h in Model.Halls)
                    {
                        <option value="@h.Id">@h.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label font-weight-600 fs-7">Select Department</label>
                <select asp-for="DepartmentId" class="form-select bg-light">
                    <option value="">-- All Departments --</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id">@d.DepartmentName (@d.DepartmentCode)</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label font-weight-600 fs-7">Status Filter</label>
                <select asp-for="Status" class="form-select bg-light" asp-items="Html.GetEnumSelectList<CollegeHallBooking.Models.BookingStatus>()">
                    <option value="">-- All Statuses --</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label font-weight-600 fs-7">Search Keyword</label>
                <input asp-for="SearchTerm" class="form-control bg-light" placeholder="Purpose or name..." />
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1 font-weight-600"><i class="bi bi-filter me-1"></i> Filter</button>
                <a asp-action="Bookings" class="btn btn-light"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white">
    <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="font-weight-700 mb-0">Booking Requests & Records</h5>
            <p class="text-muted fs-7 mb-0">Found @Model.Bookings.Count records matching criteria</p>
        </div>
    </div>
    <div class="card-body p-4">
        @if (!Model.Bookings.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-search fs-1 mb-2 d-block"></i>
                <p class="mb-0">No booking requests found for the given criteria.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Hall Name</th>
                            <th>Department</th>
                            <th>Event Purpose</th>
                            <th>Booking Date & Slot</th>
                            <th>Pax</th>
                            <th>Status</th>
                            <th>Admin Remarks</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Bookings)
                        {
                            <tr>
                                <td><span class="fw-bold text-secondary">#@b.Id</span></td>
                                <td>
                                    <strong class="text-dark d-block">@b.Hall?.Name</strong>
                                    <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@b.Hall?.Location</small>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary font-weight-600">@b.Department?.DepartmentCode</span>
                                    <small class="d-block text-muted">@b.Department?.DepartmentName</small>
                                </td>
                                <td>
                                    <span class="font-weight-600 text-dark">@b.Purpose</span>
                                </td>
                                <td>
                                    <span class="d-block font-weight-700 text-dark">@b.BookingDate.ToString("ddd, dd MMM yyyy")</span>
                                    <small class="badge bg-light text-dark border"><i class="bi bi-clock me-1"></i>@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</small>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info font-weight-600"><i class="bi bi-people me-1"></i>@b.ExpectedParticipants</span>
                                </td>
                                <td>
                                    @await Html.PartialAsync("_StatusBadge", b.Status)
                                </td>
                                <td>
                                    <small class="text-muted font-italic">@(string.IsNullOrEmpty(b.AdminRemarks) ? "-" : b.AdminRemarks)</small>
                                </td>
                                <td class="text-end">
                                    @if (b.Status == BookingStatus.Pending)
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-success font-weight-600" data-bs-toggle="modal" data-bs-target="#appModal-@b.Id">Approve</button>
                                            <button type="button" class="btn btn-outline-danger font-weight-600" data-bs-toggle="modal" data-bs-target="#rejModal-@b.Id">Reject</button>
                                        </div>

                                        <!-- Modals -->
                                        <div class="modal fade text-start" id="appModal-@b.Id" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 border-0">
                                                    <div class="modal-header border-0">
                                                        <h5 class="modal-title font-weight-700">Approve Booking</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form asp-action="ApproveBooking" method="post">
                                                        <div class="modal-body">
                                                            <input type="hidden" name="id" value="@b.Id" />
                                                            <p>Approve booking for <strong>@b.Hall?.Name</strong> on <strong>@b.BookingDate.ToString("dd MMM yyyy")</strong>?</p>
                                                            <div class="mb-3">
                                                                <label class="form-label font-weight-600">Admin Remarks</label>
                                                                <textarea name="remarks" class="form-control" rows="2"></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-0">
                                                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-success font-weight-600">Approve Request</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="modal fade text-start" id="rejModal-@b.Id" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 border-0">
                                                    <div class="modal-header border-0">
                                                        <h5 class="modal-title font-weight-700 text-danger">Reject Booking</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form asp-action="RejectBooking" method="post">
                                                        <div class="modal-body">
                                                            <input type="hidden" name="id" value="@b.Id" />
                                                            <p>Reason for rejecting request from <strong>@b.Department?.DepartmentName</strong>:</p>
                                                            <div class="mb-3">
                                                                <label class="form-label font-weight-600">Rejection Remarks</label>
                                                                <textarea name="remarks" class="form-control" rows="2" required></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-0">
                                                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger font-weight-600">Reject Request</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-7"><i class="bi bi-lock me-1"></i>Finalized</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
