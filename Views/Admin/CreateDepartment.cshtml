@model CollegeHallBooking.ViewModels.DepartmentFormViewModel
@{
    ViewData["Title"] = "Add Department & User Credentials";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <h4 class="font-weight-700 mb-0">Create Department Account</h4>
                <p class="text-muted fs-7 mb-0">Generates unique user login and initial temporary password</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateDepartment" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="DepartmentCode" class="form-label font-weight-600"></label>
                            <input asp-for="DepartmentCode" class="form-control bg-light text-uppercase" placeholder="e.g. CSE" />
                            <span asp-validation-for="DepartmentCode" class="text-danger fs-7"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="DepartmentName" class="form-label font-weight-600"></label>
                            <input asp-for="DepartmentName" class="form-control bg-light" placeholder="e.g. Department of Computer Science & Engineering" />
                            <span asp-validation-for="DepartmentName" class="text-danger fs-7"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ContactEmail" class="form-label font-weight-600"></label>
                            <input asp-for="ContactEmail" type="email" class="form-control bg-light" placeholder="e.g. cse@college.edu" />
                            <span asp-validation-for="ContactEmail" class="text-danger fs-7"></span>
                            <small class="text-muted">This email will serve as the User ID / Login Name.</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactPhone" class="form-label font-weight-600"></label>
                            <input asp-for="ContactPhone" class="form-control bg-light" placeholder="+91 9876543210" />
                            <span asp-validation-for="ContactPhone" class="text-danger fs-7"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HeadOfDepartment" class="form-label font-weight-600"></label>
                        <input asp-for="HeadOfDepartment" class="form-control bg-light" placeholder="e.g. Dr. Alan Turing" />
                        <span asp-validation-for="HeadOfDepartment" class="text-danger fs-7"></span>
                    </div>

                    <div class="border-top pt-3 mt-4 mb-3">
                        <h6 class="font-weight-700 text-dark mb-2"><i class="bi bi-shield-lock me-1 text-primary"></i> Account Login Credentials</h6>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="CreateAccount" id="createAccount" checked>
                            <label class="form-check-label font-weight-600" for="createAccount">Generate Login Account for Department</label>
                        </div>

                        <div class="mb-3 col-md-6">
                            <label asp-for="InitialPassword" class="form-label font-weight-600"></label>
                            <input asp-for="InitialPassword" class="form-control bg-light" />
                            <span asp-validation-for="InitialPassword" class="text-danger fs-7"></span>
                            <small class="text-muted">The department user will be forced to change password upon first login.</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Departments" class="btn btn-light px-4 font-weight-600">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 font-weight-600">
                            <i class="bi bi-check-circle me-1"></i> Register Department
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
