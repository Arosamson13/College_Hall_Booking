@model IEnumerable<CollegeHallBooking.Models.Department>
@{
    ViewData["Title"] = "Department Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="font-weight-700 mb-1">College Departments</h3>
        <p class="text-muted mb-0">Manage department profiles and generated login credentials</p>
    </div>
    <a asp-action="CreateDepartment" class="btn btn-primary font-weight-600 px-3 py-2 rounded-3 shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Add Department Account
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Department Name</th>
                        <th>Head of Department</th>
                        <th>Contact Email</th>
                        <th>Phone</th>
                        <th>Account Status</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dept in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-primary-subtle text-primary font-weight-700 fs-7 px-3 py-1.5">@dept.DepartmentCode</span>
                            </td>
                            <td>
                                <strong class="text-dark">@dept.DepartmentName</strong>
                            </td>
                            <td>
                                <span class="text-secondary"><i class="bi bi-person me-1"></i>@(string.IsNullOrEmpty(dept.HeadOfDepartment) ? "N/A" : dept.HeadOfDepartment)</span>
                            </td>
                            <td>
                                <a href="mailto:@dept.ContactEmail" class="text-decoration-none text-primary"><i class="bi bi-envelope me-1"></i>@dept.ContactEmail</a>
                            </td>
                            <td>
                                <span class="text-muted">@(string.IsNullOrEmpty(dept.ContactPhone) ? "N/A" : dept.ContactPhone)</span>
                            </td>
                            <td>
                                @if (dept.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success px-2.5 py-1 rounded-pill">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger px-2.5 py-1 rounded-pill">Inactive</span>
                                }
                            </td>
                            <td>
                                <span class="fs-7 text-muted">@dept.CreatedAt.ToString("dd MMM yyyy")</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
